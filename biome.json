{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": ["services/core/server/**/static/components/*.js"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "recommended": true
    }
  }
}
